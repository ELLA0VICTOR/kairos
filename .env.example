# Use auto only with a current public/data/real-market.json from pipeline:real.
# Auto falls back as a whole; the existing Record remains the synthetic ledger.
VITE_DATA_SOURCE=synthetic
VITE_DATA_BASE=
BITGET_MCP_URL=https://agent.bitget.com/mcp
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max
# Temporary optional stand-in while Qwen approval is pending. Qwen wins when both keys are set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Shared by OpenAI and Qwen. Blank uses 30000; explicit zero pauses calls.
# Soft daily limit per warm instance, reconciled to reported usage (not an account-wide billing cap).
QWEN_DAILY_TOKEN_BUDGET=30000
AGENTKEY_API_KEY=
